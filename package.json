{
  "name": "rekann-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 4310",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4310",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.dev.vars --env-file-if-exists=.env.migrations scripts/migrate.mjs",
    "mail:dev": "node scripts/mailbox.mjs",
    "test:e2e": "playwright test --project=e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "playwright test --project=unit"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "framer-motion": "13.2.0",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@oreo-design/avatar": "0.1.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0",
    "ws": "8.21.3"
  }
}
