# Copy to .dev.vars. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate a value with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4310
APP_ENV=local
EMAIL_DELIVERY=local
# Configure last, after verifying a sender domain in Resend:
# EMAIL_DELIVERY=resend
# RESEND_API_KEY=
# EMAIL_FROM=Rekann <hello@your-domain.example>

# Waitlist stays separate from application accounts. Local preview: /waitlist.
SITE_MODE=app
WAITLIST_URL=http://127.0.0.1:4310
# Production requires a separate stable signing secret (minimum 32 characters).
# WAITLIST_TOKEN_SECRET=
# Contacts access requires a full-access Resend key. May reuse RESEND_API_KEY if permitted.
# RESEND_CONTACTS_API_KEY=
# Use a dedicated Rekann waitlist segment; do not mix it with application users.
# RESEND_WAITLIST_SEGMENT_ID=
# Signing secret for /api/waitlist/webhook:
# RESEND_WEBHOOK_SECRET=
